{
  "name": "@axiapay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "auth:setup": "node scripts/configure-local-auth.mjs",
    "db:migrate": "node --env-file=.env dist/infrastructure/database/migrate.js",
    "db:types": "kysely-codegen --dialect postgres --env-file .env --exclude-pattern \"public.kysely_*\" --type-mapping '{\"xid8\":\"string\"}' --out-file ../../packages/payments-runtime/src/infrastructure/database/database.generated.ts",
    "db:types:test": "node tests/support/generate-database-types.mjs",
    "db:types:verify": "node tests/support/generate-database-types.mjs --verify"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@axiapay/payments-runtime": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "kysely-codegen": "0.20.0",
    "prettier": "3.9.6",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ioredis": "6.0.0",
    "@repo/eslint-config": "workspace:*"
  }
}
