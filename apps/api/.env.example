# Local development only. Partner funding remains disabled until configured.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://axiapay:axiapay_local_only@127.0.0.1:55432/axiapay
REDIS_CACHE_URL=redis://127.0.0.1:56379
REDIS_QUEUE_URL=redis://127.0.0.1:56380
# Mailpit is available for later notification adapters.
SMTP_HOST=127.0.0.1
SMTP_PORT=51025

# Generate a persistent local secret with pnpm --filter @axiapay/api auth:setup.
AUTH_CODE_SECRET=
AUTH_CODE_DELIVERY=mailpit
AUTH_MAILPIT_URL=http://127.0.0.1:58025

# Optional retained funding adapters. Core wallet funding needs no provider credentials.
# Keep test and live databases/ledger accounts separate.
FUNDING_ENVIRONMENT=test
# Set all fields for each enabled partner; leave unused partner fields absent.
# FUNDING_RETURN_URL=https://your-app.example/funding-return
# PAYSTACK_SECRET_KEY=sk_test_your_key
# PAYSTACK_LEDGER_ACCOUNT_ID=provisioned-paystack-partner-account-uuid
# OPAY_MERCHANT_ID=your-nigeria-merchant-id
# OPAY_PUBLIC_KEY=your-test-public-key
# OPAY_SECRET_KEY=your-test-secret-key
# OPAY_LEDGER_ACCOUNT_ID=provisioned-opay-partner-account-uuid
# OPAY_WEBHOOK_URL=https://your-api.example/v1/webhooks/wallet-funding/opay
