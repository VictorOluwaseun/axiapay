{
  "name": "@axiapay/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "payments:retry-recovery": "node --env-file-if-exists=.env dist/retry-payment-recovery.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "bullmq": "6.3.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@axiapay/backend": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prettier": "3.9.6",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "@nestjs/cli": "12.0.8",
    "kysely": "0.29.6",
    "@repo/eslint-config": "workspace:*"
  }
}
