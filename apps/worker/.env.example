# Standalone local worker. Start PostgreSQL and durable queue Redis with compose.api.yaml.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://axiapay:axiapay_local_only@127.0.0.1:55432/axiapay
REDIS_QUEUE_URL=redis://127.0.0.1:56380
# Apply migration 202610150011 and grant_payment_recovery_runtime_access for restricted roles.
PAYMENT_RECOVERY_ENABLED=true
PAYMENT_RECOVERY_CONCURRENCY=4
# Use the same provider environment and provisioned accounts as the API.
VTPASS_ENVIRONMENT=sandbox
# Set all three together to enable the provider; leave them absent otherwise.
# VTPASS_API_KEY=your-static-api-key
# VTPASS_SECRET_KEY=your-post-secret-key
# VTPASS_PUBLIC_KEY=your-get-public-key
# VTPASS_PARTNER_ACCOUNT_ID=provisioned-vtpass-clearing-account-uuid
# VTPASS_FEE_ACCOUNT_ID=provisioned-retail-fee-account-uuid
