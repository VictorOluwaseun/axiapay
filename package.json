{
  "name": "axiapay",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "dev:api": "turbo watch dev --filter=@axiapay/api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:api": "turbo run build --filter=@axiapay/api"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
